# Environment variables / secrets
.env*
!.env.example
*.pem
*.key
*.pdf

# RAG Knowledge Base (runtime content ignored except defaults)
config/rag_knowledge/*
!config/rag_knowledge/agent-10008/
!config/rag_knowledge/shared/
config/rag_knowledge/agent-10008/*
config/rag_knowledge/shared/*
!config/rag_knowledge/agent-10008/security_policy.md
!config/rag_knowledge/shared/system_overview.md
!config/rag_knowledge/shared/rag_instructions.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/

# Data & Downloads
data/downloads/*
!data/downloads/.gitkeep
data/flat-histories/*
!data/flat-histories/.gitkeep

# Resources sandboxes
system_resources/*
agents_resources/*
!system_resources/.gitkeep
!system_resources/agy/.gitkeep
!system_resources/agy/auto/.gitkeep
!agents_resources/.gitkeep
e2e_testing_harness/.test_run_counter

# IDE / Editor
.vscode/
.idea/
.obsidian/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Runtime cache and usage storage
data/thread_usage_data.json
data/pricing/model_pricing_cache.json
data/state/*
!data/state/app_settings.json
!data/state/.gitkeep
data/.rag_cache/
data/*.db*
*.db
*.db-wal
*.db-shm
*.migrated

# Audit logs (runtime files preserved locally, not tracked in git)
data/audit/*
!data/audit/.gitkeep

# Temporary commit message files
.commit_msg*
commit_msg_*.txt
