# Slack API Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-user-oauth-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_TEST_CHANNEL_ID=C0123456789
SLACK_ADMIN_USER_IDS=U0123456789

# LLM Provider API Keys
GEMINI_API_KEY=your-gemini-api-key
MISTRAL_API_KEY=your-mistral-api-key

# Server & Local Tools Settings
PORT=8000
TOOLS_WORKSPACE_DIR=.

# Admin API Basic Authentication (for /api/* endpoints)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Non-Repudiable Audit Logging (HMAC secret or JSON keyring for rotation)
AUDIT_HMAC_SECRET=
# AUDIT_HMAC_KEYS_JSON={"k2":"<new-secret>","k1":"<old-secret>"}
# AUDIT_HMAC_ACTIVE_KEY_ID=k2

# Optional Centralized Path Overrides (Defaults anchored relative to project root)
# IZVOR_CONFIG_DIR=config
# IZVOR_DATA_DIR=data
# IZVOR_DB_PATH=data/izvor.db
# IZVOR_SETTINGS_DIR=config/settings
# IZVOR_PERSONAS_DIR=config/personas
# IZVOR_WORKFLOWS_DIR=config/workflows
# IZVOR_SKILLS_DIR=config/skills
# IZVOR_AVATARS_DIR=config/avatars
# IZVOR_RAG_KNOWLEDGE_DIR=config/rag_knowledge
# IZVOR_ENGINE_SETTINGS_DIR=engine/settings
# IZVOR_SYSTEM_AGENT_SETTINGS_FILE=data/settings/system_agent_settings.json
# IZVOR_PROMPTS_DIR=engine/prompts
# IZVOR_ENGINE_SKILLS_DIR=engine/skills/builtin
# IZVOR_ENGINE_WORKFLOWS_DIR=engine/workflows
# IZVOR_STATE_DIR=data/state
# IZVOR_APP_SETTINGS_FILE=data/state/app_settings.json
# IZVOR_PRESIDIO_SKILL_EXCLUSIONS_FILE=data/state/presidio_skill_exclusions.json
# IZVOR_BACKUPS_DIR=data/backups
# IZVOR_WORKFLOWS_BACKUP_DIR=data/backups/workflows
# IZVOR_PRICING_DIR=data/pricing
# IZVOR_THREAD_DATA_DIR=data/thread
# IZVOR_RAG_CACHE_DIR=data/.rag_cache
# IZVOR_LANCEDB_DIR=data/.rag_cache/lancedb
# IZVOR_RAG_MANIFEST_PATH=data/.rag_cache/file_manifest.json
# IZVOR_AUDIT_DIR=data/audit
# IZVOR_DOWNLOADS_DIR=data/downloads
# IZVOR_HISTORIES_DIR=data/flat-histories
# IZVOR_AGENTS_RESOURCES_DIR=agents_resources
# IZVOR_THREAD_NOTES_DIR=data/thread_notes
# IZVOR_SYSTEM_RESOURCES_DIR=system_resources

# Operational & Performance Settings
# TRUST_PROXY_HEADERS=false
# THREAD_STATE_TTL_SECONDS=3600.0
# MAX_TRACKED_THREADS=500
# TOOL_INTERMEDIATE_UPDATE_DELAY_SECONDS=5.0
# WEB_CONCURRENCY=1

# Display & Identity Settings
# BASE_AVATAR_URL=https://zxy.something.com/  # PUBLIC URL of this app (e.g. Cloudflare tunnel hostname) - Slack fetches icon_url server-side, so a placeholder like izvor.local will not load avatars

# Slack Usage Channel Settings
# USAGE_CHANNEL_ID=
# USAGE_CHANNEL_NAME=izvor-usage

# Additional / Optional LLM Provider API Keys
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# COHERE_API_KEY=
# PERPLEXITY_API_KEY=
# TOGETHER_API_KEY=
# META_API_KEY=
# META_API_BASE=
